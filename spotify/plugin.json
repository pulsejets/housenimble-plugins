{
  "schemaVersion": 1,
  "id": "housenimble.spotify",
  "name": "Spotify og Sonos",
  "description": "Eksperimentel Spotify-controller med eksplicit Spotify Connect-højttaler, afspilning, lydstyrke og bibliotek. Kræver endnu manglende HTTP/OAuth i core.",
  "version": "0.1.0",
  "apiVersion": 1,
  "runtime": "lua-5.4",
  "entry": "main.lua",
  "license": "MIT",
  "boards": [
    "esp32-p4"
  ],
  "permissions": {
    "network": [
      "https://api.spotify.com"
    ],
    "mqttSubscribe": [],
    "mqttPublish": [],
    "storageBytes": 0
  },
  "limits": {
    "memoryBytes": 262144,
    "instructionsPerCallback": 100000,
    "packageBytes": 131072
  }
}
