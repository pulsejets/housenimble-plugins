{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "country": {
      "type": "string",
      "title": "Land / marked",
      "enum": [
        "GLOBAL",
        "DK",
        "SE",
        "DE"
      ],
      "default": "GLOBAL"
    },
    "language": {
      "type": "string",
      "title": "Sprog",
      "enum": [
        "da",
        "en"
      ],
      "default": "da"
    },
    "timezone": {
      "type": "string",
      "default": "Europe/Copenhagen"
    }
  }
}
